# Local development run (default when ENV is not set)
BASE_URL=http://127.0.0.1:5055
API_BASE_URL=https://jsonplaceholder.typicode.com
# Start the Flask app automatically for the test session
START_APP=true
HEADLESS=true
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=10000
# Set to true to let the rule-based healer repair broken locators (see docs/SELF_HEALING.md)
SELF_HEAL=false
REPORTS_DIR=reports
